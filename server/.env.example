# PostgreSQL connection string
DATABASE_URL=postgres://finance:finance@localhost:5432/finance
# HTTP port
PORT=3000
# Set to "production" behind HTTPS (enables Secure cookies)
NODE_ENV=development
# Allow creating additional users after the first one (default: only first-run setup)
ALLOW_REGISTRATION=false
# Encryption key for stored Telegram/monobank tokens (long random string). Required in production.
APP_SECRET=
